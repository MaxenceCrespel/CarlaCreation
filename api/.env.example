PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000

# Postgres connection string
DATABASE_URL=postgres://salon:salon@localhost:5432/salon

# Generate a strong random secret, e.g.: openssl rand -hex 64
JWT_SECRET=replace_this_with_a_long_random_secret

# Controls the `Secure` flag on session/CSRF cookies. Leave unset to default
# to NODE_ENV (true in production). Set explicitly to false if you are
# running in production mode (e.g. `docker compose` with NODE_ENV=production)
# but accessing the site over plain http:// (no TLS in front of it yet) —
# otherwise the browser silently drops the cookies and login won't work.
# COOKIE_SECURE=false

# SMTP is entirely optional. Leave SMTP_HOST unset to run without email —
# booking confirmations are just logged to the console instead of sent, so
# nothing breaks. Fill these in once you have a real mailbox/provider (see
# README "Emails de confirmation" for examples: Gmail, Mailtrap, SendGrid…).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Carla Création" <no-reply@carlacreation.example>

# Also entirely optional. Leave unset to skip real distance calculation —
# à domicile bookings still work, just with the flat base travel fee (no
# per-km surcharge, no distance/duration shown to the client or admin).
# Free API key, no card required: https://openrouteservice.org/dev/#/signup
# ORS_API_KEY=

# Also entirely optional. Leave unset to skip push notifications — the
# "Activer les notifications" button in the admin's Mon compte stays
# hidden, new-booking emails still go out as usual. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Never regenerate on a live deployment — it invalidates every admin's
# existing subscription (they'd need to re-enable).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
