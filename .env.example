# Fichier .env RACINE — utilisé uniquement sur le VPS (staging/prod), lu par
# docker-compose.staging.yml et docker-compose.prod.yml via la substitution
# ${VAR} native de Docker Compose. Différent de api/.env (celui-là est lu
# par le conteneur `web` via env_file, et n'existe pas sur un checkout
# local classique) — et distinct de api/.env, lui aussi présent une fois
# par environnement (un sur /opt/carla-creation pour staging+prod, voir
# plus bas).
#
# Copier en `.env` (à la racine, à côté de docker-compose.yml) sur le VPS,
# ne jamais commiter le résultat.

# Deux secrets distincts, un par environnement — une session admin volée
# sur l'un ne doit jamais être valable sur l'autre. openssl rand -hex 64
# pour chacun.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-64
PROD_JWT_SECRET=change-me-generate-a-different-one-with-openssl-rand-hex-64

# Nom de domaine utilisé par Caddy pour le certificat HTTPS — staging et
# prod partagent le même DOMAIN (staging.<DOMAIN> vs <DOMAIN> directement,
# voir deploy/Caddyfile).
DOMAIN=example.com
